# Unique identity for this observer. Do not reuse across independent vantage points.
OBSERVER_ID=observer-rimini-01

# Candidate Onion hosts, one per line in /config/candidates.txt
CANDIDATES_FILE=/config/candidates.txt

# Tor SOCKS endpoint reachable by the probe container.
# socks5h keeps .onion resolution inside Tor.
TOR_SOCKS=socks5h://tor:9050

# Application health endpoint exposed through the Onion Service.
PROBE_PATH=/health
PROBE_INTERVAL_SECONDS=30
PROBE_TIMEOUT_SECONDS=15
OBSERVATIONS_FILE=/data/observations.jsonl
