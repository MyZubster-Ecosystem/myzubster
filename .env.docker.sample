# ---- Database ----
MONGODB_URI=mongodb://admin:password@mongodb:27017/myzubster?authSource=admin
MONGODB_DB_NAME=myzubster

# ---- JWT ----
JWT_SECRET=your_jwt_secret_here_change_this
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT=10

# ---- Monero ----
MONERO_MAIN_WALLET_ADDRESS=YOUR_MONERO_ADDRESS_HERE
MONERO_RPC_URL=http://monero:18081
MONERO_WALLET_RPC_URL=http://monero-wallet:18082

# ---- Gateway ----
API_URL=http://localhost:10000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ---- Security ----
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=100
HELMET_ENABLED=true
COMPRESSION_ENABLED=true

# ---- Logging ----
LOG_LEVEL=info
LOG_FORMAT=json

# ---- Feature Flags ----
ENABLE_PAYMENTS=true
ENABLE_ANIMAL_REGISTRY=true
ENABLE_PLANT_REGISTRY=true
ENABLE_BOUNTY_PROGRAM=true
