{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myzubster.example/schemas/bounty-instance-v1.json",
  "title": "MyZubster Bounty Instance v1",
  "type": "object",
  "required": ["bounty_id", "program", "title", "reward_myz", "status", "history"],
  "properties": {
    "bounty_id": {"type": "string", "minLength": 3},
    "program": {"type": "string", "minLength": 2},
    "title": {"type": "string", "minLength": 3},
    "reward_myz": {"type": "integer", "minimum": 0},
    "status": {"enum": ["OPEN", "CLAIMED", "SUBMITTED", "UNDER_REVIEW", "VERIFIED", "REJECTED", "MYZ_RECORDED"]},
    "source_issue": {"type": ["string", "null"]},
    "claimant": {"type": ["string", "null"]},
    "submission": {
      "type": ["object", "null"],
      "properties": {
        "submitted_at": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "review": {
      "type": ["object", "null"],
      "properties": {
        "reviewed_at": {"type": "string"},
        "decision": {"enum": ["VERIFIED", "REJECTED", "REVISION_REQUESTED"]},
        "reviewer": {"type": "string"},
        "notes": {"type": "string"}
      },
      "additionalProperties": true
    },
    "ledger_entry_id": {"type": ["string", "null"]},
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["at", "from", "to"],
        "properties": {
          "at": {"type": "string"},
          "from": {"type": ["string", "null"]},
          "to": {"type": "string"},
          "actor": {"type": ["string", "null"]},
          "note": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}