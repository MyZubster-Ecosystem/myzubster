{
  "name": "myzubster-gateway",
  "version": "1.0.0",
  "description": "MyZubster Gateway - Monero Payment Gateway & Animal Registry",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "build": "npm install",
    "smoke:zorgax-research": "node scripts/zorgax-research-vps-smoke.js",
    "privacy:migrate-locations": "node scripts/migrate-private-locations.js",
    "metaverse:configure:n4k48": "node scripts/metaverse/configure-n4k48.js",
    "metaverse:configure:yassen": "node scripts/metaverse/configure-yassen.js",
    "metaverse:load-baseline": "node scripts/realtime-load-baseline.js",
    "metaverse:realtime-self-check": "node scripts/realtime-self-check.js",
    "nft:compile": "hardhat compile",
    "nft:test:local": "hardhat run scripts/nft/test-comic-nft.js",
    "nft:deploy:base-sepolia": "hardhat run scripts/nft/deploy-comic-nft.js --network baseSepolia",
    "nft:mint:comic-001": "hardhat run scripts/nft/mint-comic-001.js --network baseSepolia"
  },
  "dependencies": {
    "@vercel/functions": "^3.9.5",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^7.8.11",
    "morgan": "^1.11.0",
    "nodemailer": "^9.0.5",
    "redis": "^4.7.0",
    "socket.io": "^4.7.2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@babel/preset-env": "^8.0.2",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@octokit/rest": "^22.0.1",
    "@openzeppelin/contracts": "4.9.6",
    "@types/jest": "^30.0.0",
    "ajv": "^8.20.0",
    "axios-retry": "^4.5.0",
    "chai": "^6.2.2",
    "eslint": "^8.57.1",
    "ethers": "6.17.0",
    "hardhat": "2.29.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "socket.io-client": "^4.8.3",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": "24.x"
  },
  "keywords": [
    "monero",
    "payment-gateway",
    "animal-registry",
    "plant-map",
    "blockchain",
    "privacy"
  ],
  "author": "Daniel Ioni",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MyZubster-Ecosystem/MyZubsterGateway"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}