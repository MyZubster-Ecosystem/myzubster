{
  "name": "myzubster-gateway",
  "version": "1.0.0",
  "description": "MyZubster Gateway - Monero Payment Gateway & Animal Registry",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node scripts/run-tests.js",
    "build": "npm install",
    "smoke:zorgax-research": "node scripts/zorgax-research-vps-smoke.js",
    "privacy:migrate-locations": "node scripts/migrate-private-locations.js",
    "metaverse:configure:n4k48": "node scripts/metaverse/configure-n4k48.js",
    "metaverse:configure:yassen": "node scripts/metaverse/configure-yassen.js",
    "metaverse:load-baseline": "node scripts/realtime-load-baseline.js",
    "metaverse:realtime-self-check": "node scripts/realtime-self-check.js",
    "nft:compile": "cd nft-tools && ../node_modules/.bin/hardhat compile",
    "nft:test:local": "cd nft-tools && ../node_modules/.bin/hardhat run scripts/test-comic-nft.mjs",
    "nft:deploy:base-sepolia": "cd nft-tools && ../node_modules/.bin/hardhat run scripts/deploy-comic-nft.mjs --network baseSepolia",
    "nft:mint:comic-001": "cd nft-tools && ../node_modules/.bin/hardhat run scripts/mint-comic-001.mjs --network baseSepolia",
    "evidence:validate-interoperability": "node scripts/validate-interoperability-checkpoints.js",
    "evidence:validate-zorgax-capabilities": "node scripts/validate-zorgax-capabilities.js",
    "evidence:validate-external-projects": "node scripts/validate-external-project-verifications.js",
    "walkthrough:seller": "node scripts/run-seller-walkthrough-live.js"
  },
  "dependencies": {
    "@vercel/functions": "^3.6.1",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.9",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ethers": "6.17.0",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^7.8.11",
    "morgan": "^1.11.0",
    "nodemailer": "^10.0.9",
    "redis": "^4.7.0",
    "socket.io": "^4.7.2",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@nomicfoundation/hardhat-ethers": "^4.2.0",
    "@octokit/rest": "^22.0.1",
    "@openzeppelin/contracts": "4.9.6",
    "@types/jest": "^30.0.0",
    "ajv": "^8.20.0",
    "axios-retry": "^4.5.0",
    "chai": "^6.2.2",
    "eslint": "^8.57.1",
    "hardhat": "^3.19.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.0.3",
    "socket.io-client": "^4.8.3",
    "supertest": "^6.3.4"
  },
  "engines": {
    "node": "24.x"
  },
  "keywords": [
    "monero",
    "payment-gateway",
    "animal-registry",
    "plant-map",
    "blockchain",
    "privacy"
  ],
  "author": "Daniel Ioni",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MyZubster-Ecosystem/MyZubsterGateway"
  },
  "overrides": {
    "qs": "6.16.0",
    "hardhat": {
      "adm-zip": "0.6.1",
      "solc": {
        "tmp": "0.2.7"
      },
      "mocha": {
        "serialize-javascript": "7.0.5"
      }
    },
    "braces": "3.0.3"
  }
}
