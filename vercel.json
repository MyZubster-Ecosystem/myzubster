{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    },
    {
      "src": "public/fumetto.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/zorgax/?",
      "dest": "https://myzubster-gateway.vercel.app/zargox"
    },
    {
      "src": "/zargox/?",
      "dest": "https://myzubster-gateway.vercel.app/zargox"
    },
    {
      "src": "/api/zorgax/(.*)",
      "dest": "https://myzubster-gateway.vercel.app/api/zargox/$1"
    },
    {
      "src": "/api/zargox/(.*)",
      "dest": "https://myzubster-gateway.vercel.app/api/zargox/$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/fumetto/?",
      "dest": "/public/fumetto.html"
    },
    {
      "src": "/fumetto.html",
      "dest": "/public/fumetto.html"
    },
    {
      "src": "/comic/?",
      "dest": "/public/fumetto.html"
    },
    {
      "src": "/comic.html",
      "dest": "/public/fumetto.html"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
