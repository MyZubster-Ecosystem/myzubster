{
  "version": 2,
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/bounties-registry.js",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    },
    {
      "src": "public/fumetto.html",
      "use": "@vercel/static"
    },
    {
      "src": "public/fumetto-sentinel.html",
      "use": "@vercel/static"
    },
    {
      "src": "public/come-funziona.html",
      "use": "@vercel/static"
    },
    {
      "src": "public/world-state/metasploit-sentinel.json",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/zorgax/?",
      "dest": "https://myzubster-gateway.vercel.app/zargox"
    },
    {
      "src": "/zargox/?",
      "dest": "https://myzubster-gateway.vercel.app/zargox"
    },
    {
      "src": "/api/zorgax/(.*)",
      "dest": "https://myzubster-gateway.vercel.app/api/zargox/$1"
    },
    {
      "src": "/api/zargox/(.*)",
      "dest": "https://myzubster-gateway.vercel.app/api/zargox/$1"
    },
    {
      "src": "/api/bounties/?",
      "dest": "/api/bounties-registry.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/come-funziona/?",
      "dest": "/public/come-funziona.html"
    },
    {
      "src": "/how-it-works/?",
      "dest": "/public/come-funziona.html"
    },
    {
      "src": "/fumetto/sentinel/?",
      "dest": "/public/fumetto-sentinel.html"
    },
    {
      "src": "/comic/sentinel/?",
      "dest": "/public/fumetto-sentinel.html"
    },
    {
      "src": "/world-state/metasploit-sentinel.json",
      "dest": "/public/world-state/metasploit-sentinel.json"
    },
    {
      "src": "/fumetto/?",
      "dest": "/public/fumetto.html"
    },
    {
      "src": "/fumetto.html",
      "dest": "/public/fumetto.html"
    },
    {
      "src": "/comic/?",
      "dest": "/public/fumetto.html"
    },
    {
      "src": "/comic.html",
      "dest": "/public/fumetto.html"
    },
    {
      "src": "/robots.txt",
      "dest": "/robots.txt"
    },
    {
      "src": "/sitemap.xml",
      "dest": "/sitemap.xml"
    },
    {
      "src": "/static/(.*)",
      "dest": "/frontend/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/index.html"
    }
  ]
}
