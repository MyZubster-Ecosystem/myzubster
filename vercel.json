{
  "version": 2,
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node", "config": { "includeFiles": ["myz/ledger.json", "myz/settlement-queue.json", "myz/settlement-policy.json"] } },
    { "src": "api/bounties-registry.js", "use": "@vercel/node" },
    { "src": "frontend/package.json", "use": "@vercel/static-build", "config": { "distDir": "build" } },
    { "src": "public/funnel.html", "use": "@vercel/static" },
    { "src": "public/funnel.js", "use": "@vercel/static" },
    { "src": "public/space-station.html", "use": "@vercel/static" },
    { "src": "public/fumetto.html", "use": "@vercel/static" },
    { "src": "public/fumetto-sentinel.html", "use": "@vercel/static" },
    { "src": "public/come-funziona.html", "use": "@vercel/static" },
    { "src": "public/press.html", "use": "@vercel/static" },
    { "src": "public/zorgax-email-profile.html", "use": "@vercel/static" },
    { "src": "public/social-login.html", "use": "@vercel/static" },
    { "src": "public/zorgax-profile-onboarding.html", "use": "@vercel/static" },
    { "src": "public/facebook-zorgax.html", "use": "@vercel/static" },
    { "src": "public/community-marketplace.html", "use": "@vercel/static" },
    { "src": "public/zorgax-build.html", "use": "@vercel/static" },
    { "src": "public/payment-dashboard.html", "use": "@vercel/static" },
    { "src": "public/payment-dashboard-auth.html", "use": "@vercel/static" },
    { "src": "public/zorgax-card.js", "use": "@vercel/static" },
    { "src": "public/nicola-project-planner.html", "use": "@vercel/static" },
    { "src": "public/darkode.html", "use": "@vercel/static" },
    { "src": "public/darkode-tracking.js", "use": "@vercel/static" },
    { "src": "public/world-state/metasploit-sentinel.json", "use": "@vercel/static" }
  ],
  "crons": [
    { "path": "/api/zorgax/email/run", "schedule": "0 8 * * *" },
    { "path": "/api/robots/simulation/cron", "schedule": "10 8 * * *" },
    { "path": "/api/robots/evidence/arpae/capture/cron", "schedule": "20 8 * * *" }
  ],
  "routes": [
    { "src": "/funnel/?", "dest": "/public/funnel.html" },
    { "src": "/funnel\\.html/?", "dest": "/public/funnel.html" },
    { "src": "/funnel\\.js/?", "dest": "/public/funnel.js" },
    { "src": "/payment-dashboard\\.html/?", "status": 308, "headers": { "Location": "/payment-dashboard" } },
    { "src": "/payment-dashboard/?", "headers": { "X-Robots-Tag": "noindex, nofollow" }, "dest": "/public/payment-dashboard-auth.html" },
    { "src": "/payment-dashboard-raw/?", "headers": { "X-Robots-Tag": "noindex, nofollow" }, "dest": "/public/payment-dashboard.html" },
    { "src": "/api/payment-dashboard/(.*)", "dest": "/api/index.js" },
    { "src": "/press\\.html/?", "status": 308, "headers": { "Location": "/press" } },
    { "src": "/media/?", "status": 308, "headers": { "Location": "/press" } },
    { "src": "/media-kit/?", "status": 308, "headers": { "Location": "/press" } },
    { "src": "/social-login\\.html/?", "status": 308, "headers": { "Location": "/social-login" } },
    { "src": "/zorgax-profile-onboarding\\.html/?", "status": 308, "headers": { "Location": "/zorgax-profile-onboarding" } },
    { "src": "/zorgax-email-profile\\.html/?", "status": 308, "headers": { "Location": "/zorgax-email-profile" } },
    { "src": "/facebook-zorgax\\.html/?", "status": 308, "headers": { "Location": "/facebook-zorgax" } },
    { "src": "/press/?", "dest": "/public/press.html" },
    { "src": "/social-login/?", "headers": { "X-Robots-Tag": "noindex, nofollow" }, "dest": "/public/social-login.html" },
    { "src": "/zorgax-profile-onboarding/?", "headers": { "X-Robots-Tag": "noindex, nofollow" }, "dest": "/public/zorgax-profile-onboarding.html" },
    { "src": "/zorgax-email-profile/?", "headers": { "X-Robots-Tag": "noindex, nofollow" }, "dest": "/public/zorgax-email-profile.html" },
    { "src": "/facebook-zorgax/?", "headers": { "X-Robots-Tag": "noindex, nofollow" }, "dest": "/public/facebook-zorgax.html" },
    { "src": "/zorgax-build/?", "dest": "/public/zorgax-build.html" },
    { "src": "/zorgax-card\\.js/?", "dest": "/public/zorgax-card.js" },
    { "src": "/nicola-project-planner/?", "headers": { "X-Robots-Tag": "noindex, nofollow" }, "dest": "/public/nicola-project-planner.html" },
    { "src": "/nicola-project-planner\\.html/?", "headers": { "X-Robots-Tag": "noindex, nofollow" }, "dest": "/public/nicola-project-planner.html" },
    { "src": "/darkode/?", "dest": "/public/darkode.html" },
    { "src": "/darkode\\.html/?", "status": 308, "headers": { "Location": "/darkode" } },
    { "src": "/darkode-tracking\\.js/?", "dest": "/public/darkode-tracking.js" },
    { "src": "/api/auth/social/(google|github|facebook)/(start|callback)/?", "dest": "/api/index.js" },
    { "src": "/api/zorgax/assistant/(.*)", "dest": "/api/index.js" },
    { "src": "/api/zorgax/stripe/(.*)", "dest": "/api/index.js" },
    { "src": "/api/zorgax/monetization/(.*)", "dest": "/api/index.js" },
    { "src": "/api/zorgax/build/(.*)", "dest": "/api/index.js" },
    { "src": "/api/zorgax/life/(.*)", "dest": "/api/index.js" },
    { "src": "/api/zorgax/email/(.*)", "dest": "/api/index.js" },
    { "src": "/api/zorgax/capital/(.*)", "dest": "/api/index.js" },
    { "src": "/api/zorgax/digital-business/(.*)", "dest": "/api/index.js" },
    { "src": "/api/robots/(.*)", "dest": "/api/index.js" },
    { "src": "/zorgax/?", "dest": "/api/index.js" },
    { "src": "/zargox/?", "dest": "https://myzubster-gateway.vercel.app/zargox" },
    { "src": "/api/zorgax/(.*)", "dest": "https://myzubster-gateway.vercel.app/api/zargox/$1" },
    { "src": "/api/zargox/(.*)", "dest": "https://myzubster-gateway.vercel.app/api/zargox/$1" },
    { "src": "/api/bounties/?", "dest": "/api/bounties-registry.js" },
    { "src": "/api/space-station/?", "dest": "https://myzubster-space-station.vercel.app/api/health" },
    { "src": "/api/space-station/(.*)", "dest": "https://myzubster-space-station.vercel.app/api/$1" },
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/community/?", "dest": "/public/community-marketplace.html" },
    { "src": "/gardens-map/?", "dest": "/public/community-marketplace.html" },
    { "src": "/community-marketplace.html", "dest": "/public/community-marketplace.html" },
    { "src": "/come-funziona/?", "dest": "/public/come-funziona.html" },
    { "src": "/how-it-works/?", "dest": "/public/come-funziona.html" },
    { "src": "/fumetto/sentinel/?", "dest": "/public/fumetto-sentinel.html" },
    { "src": "/comic/sentinel/?", "dest": "/public/fumetto-sentinel.html" },
    { "src": "/world-state/metasploit-sentinel.json", "dest": "/public/world-state/metasploit-sentinel.json" },
    { "src": "/fumetto/?", "dest": "/api/index.js" },
    { "src": "/fumetto.html", "dest": "/api/index.js" },
    { "src": "/comic/?", "dest": "/api/index.js" },
    { "src": "/comic.html", "dest": "/api/index.js" },
    { "src": "/robots.txt", "dest": "/frontend/robots.txt" },
    { "src": "/sitemap.xml", "dest": "/frontend/sitemap.xml" },
    { "src": "/manifest.json", "dest": "/frontend/manifest.json" },
    { "src": "/favicon.svg", "dest": "/frontend/favicon.svg" },
    { "src": "/static/(.*)", "dest": "/frontend/static/$1" },
    { "src": "/comics/(.*)", "dest": "/api/index.js" },
    { "src": "/space-station/?", "dest": "/public/space-station.html" },
    { "src": "/space-station\\.html/?", "status": 308, "headers": { "Location": "/space-station" } },
    { "src": "/(.*)", "dest": "/frontend/index.html" }
  ]
}
