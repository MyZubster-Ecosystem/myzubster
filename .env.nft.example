# MyZubster Character NFT deployment / verification
# Sepolia chain ID: 11155111
EVM_RPC_URL_11155111=https://YOUR_SEPOLIA_RPC
EVM_DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY
CHARACTER_NFT_MAX_SUPPLY=10000

# Fill these after Character NFT deployment
MYZUBSTER_CHARACTER_CONTRACT=0xDEPLOYED_CHARACTER_CONTRACT
NFT_CONTRACT_ALLOWLIST_11155111=0xDEPLOYED_CHARACTER_CONTRACT

# Required for verified marketplace payments on Sepolia.
# This must be the deployed MYZ ERC-20 contract address for the same chain.
MYZ_TOKEN_ADDRESS_11155111=0xDEPLOYED_MYZ_TOKEN

# EVM_DEPLOYER_PRIVATE_KEY is deployment-only. Do not keep it in runtime environments.
