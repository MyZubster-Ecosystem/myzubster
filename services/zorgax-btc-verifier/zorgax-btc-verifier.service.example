[Unit]
Description=Zorgax BTC Electrum payment verifier
After=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/myzubster
EnvironmentFile=/etc/myzubster/zorgax-btc-verifier.env
ExecStart=/usr/bin/node /opt/myzubster/services/zorgax-btc-verifier/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/.electrum

[Install]
WantedBy=multi-user.target
