PORT=3009
MONGODB_URI=mongodb://localhost:27017/myzubster

# Monitoring
MONITOR_AUTO_RECOVERY=false
MONITOR_RECOVERY_MODE=pm2
MONITOR_INTERVAL_MS=60000
MONITOR_CHECK_TIMEOUT_MS=1500
MONITOR_LOG_DIR=./logs
MONITOR_LOG_FILE=monitoring.log
MONITOR_LOG_MAX_BYTES=5242880
MONITOR_SSH_CHECK_ENABLED=true
MONITOR_SSH_HOST=127.0.0.1
MONITOR_SSH_PORT=22
PM2_APP_NAME=myzubster-backend
SYSTEMD_BACKEND_SERVICE=myzubster-backend
SYSTEMD_MONGO_SERVICE=mongod
SYSTEMD_SSH_SERVICE=ssh

# Optional alert channels
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
