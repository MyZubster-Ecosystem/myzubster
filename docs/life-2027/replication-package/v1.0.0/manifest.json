      "path": "docs/life-2027/replication-package/v1.0.0/site-readiness-template.md",
      "version": "1.0.0",
      "requiredMarkers": [
        "## Site and authority",
        "## Sensors, connectivity and data",
        "## KPI and evidence readiness",
        "## Governance, security and privacy",
        "## Human validation and automation safety",
        "## Blockers and readiness decision"
      ]
    },
    {
      "id": "replication-decision-matrix",
      "path": "docs/life-2027/replication-package/v1.0.0/replication-decision-matrix.md",
      "version": "1.0.0",
      "requiredMarkers": [
        "| Capability | Reuse | Localize | Block | Evidence required | Decision owner |",
        "REUSE",
        "LOCALIZE",
        "BLOCK"
      ]
    }
  ],
  "auditReferences": [
    {
      "id": "environmental-evidence-schema",
      "path": "docs/life-2026/ENVIRONMENTAL_DATA_MODEL.md",
