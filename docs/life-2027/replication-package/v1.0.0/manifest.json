    {
      "id": "iot-adapter-boundary",
      "path": "docs/life-2026/TECHNICAL_ARCHITECTURE.md",
      "boundary": "IoT architecture and normalized readings do not prove measurement validity."
    },
    {
      "id": "human-validation",
      "path": "docs/life-2027/ZORGAX_LIFE_AUTOMATION_V1.md",
