# ============================================================
# MyZubster Ecosystem — Docker Environment Template
# Copy to .env and adjust before running docker-compose up
# ============================================================

# --- MongoDB ---
MONGO_INITDB_DATABASE=myzubster
MONGO_INITDB_ROOT_USERNAME=myzubster
MONGO_INITDB_ROOT_PASSWORD=changeme_in_production

# --- Backend ---
BACKEND_PORT=3009
BACKEND_MONGODB_URI=mongodb://myzubster:changeme_in_production@mongodb:27017/myzubster?authSource=admin

# --- Frontend ---
FRONTEND_PORT=3000
REACT_APP_API_URL=http://localhost:3009

# --- Gateway ---
GATEWAY_PORT=3001
GATEWAY_MONGODB_URI=mongodb://myzubster:changeme_in_production@mongodb:27017/myzubster?authSource=admin

# --- Marketplace ---
MARKETPLACE_PORT=4000
MARKETPLACE_DB_PATH=/app/data/marketplace.db

# --- AI Automation ---
AI_AUTOMATION_PORT=5000
AI_AUTOMATION_MONGODB_URI=mongodb://myzubster:changeme_in_production@mongodb:27017/myzubster?authSource=admin