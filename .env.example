# MyZubsterGateway - FCMP++ Integration

Environment variables for FCMP++ support.

## Monero RPC
MONERO_RPC_URL=http://localhost:18081/json_rpc
MONERO_DAEMON_ADDRESS=node.moneroworld.com:18081
MONERO_NETWORK=mainnet

## FCMP++ Configuration
# Enable FCMP++ support (default: false - RingCT only)
FCMP_ENABLED=false

# FCMP++ network: mainnet, testnet, stagenet
FCMP_NETWORK=mainnet

# FCMP++ proof format: "seraphis", "fcmp", "fcmp-plus-plus"
FCMP_PROOF_FORMAT=fcmp-plus-plus

# FCMP++ activation height (block height when FCMP++ activates on network)
# Set to 0 to use network default, or specific height for testing
FCMP_ACTIVATION_HEIGHT=0

# Fallback to RingCT if FCMP++ fails
FCMP_FALLBACK_TO_RINGCT=true