# Zorgax GitHub Issue Agent
# Copy values into the deployment secret manager/runtime environment.
# NEVER commit real credentials.

ZORGAX_GITHUB_WRITE_ENABLED=false
ZORGAX_GITHUB_ALLOWED_REPOS=MyZubster-Ecosystem/myzubster
ZORGAX_ADMIN_KEY=

# Preferred production authentication: GitHub App
# App ID visible in the GitHub App settings page.
ZORGAX_GITHUB_APP_ID=
# Optional. If omitted, Zorgax auto-discovers the installation for ZORGAX_GITHUB_OWNER.
ZORGAX_GITHUB_INSTALLATION_ID=
ZORGAX_GITHUB_OWNER=MyZubster-Ecosystem
# Store the PEM only in the deployment secret manager. Literal \n sequences are supported.
ZORGAX_GITHUB_PRIVATE_KEY=

# Legacy fallback only. Avoid long-lived personal tokens in production.
ZORGAX_GITHUB_TOKEN=
