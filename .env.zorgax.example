# Zorgax GitHub Issue Agent
# Copy values into the deployment secret manager/runtime environment.
# NEVER commit real credentials.

ZORGAX_GITHUB_WRITE_ENABLED=false
ZORGAX_GITHUB_ALLOWED_REPOS=MyZubster-Ecosystem/myzubster
ZORGAX_ADMIN_KEY=

# Current Issue Agent token input. Prefer a short-lived GitHub App installation token in production.
ZORGAX_GITHUB_TOKEN=

# Production GitHub App identity (future runtime token minting support)
ZORGAX_GITHUB_APP_ID=
ZORGAX_GITHUB_INSTALLATION_ID=
ZORGAX_GITHUB_PRIVATE_KEY=
